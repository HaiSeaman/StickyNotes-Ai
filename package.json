{
  "name": "js-sticky-note",
  "version": "1.0.0",
  "productName": "便签",
  "description": "Windows 桌面便签 - Electron 毛玻璃风格",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "npx @electron/packager . --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --asar --prune --ignore=\"^dist(/|$)\" --ignore=node_modules/.cache --ignore=\\.reasonrix --ignore=electron_err.log --ignore=electron_out.log --ignore=startup-err.log --ignore=startup.log --ignore=_fix_line.js --ignore=_fix_m1.js --ignore=test_load.js --ignore=_check_asar.js --ignore=gen_icon.js --ignore=\"v[0-9].*_.*\\.md\" --ignore=CODE_WIKI.md --ignore=代码审计报告.md --ignore=.git --ignore=.gitignore"
  },
  "keywords": [
    "sticky-note",
    "electron",
    "notes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "electron": "^42.7.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "adm-zip": "^0.6.0",
    "dompurify": "^3.2.0",
    "howler": "^2.2.4",
    "marked": "^12.0.2",
    "music-metadata-browser": "^2.5.11"
  }
}
