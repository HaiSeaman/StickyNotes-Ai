{
  "name": "js-sticky-note",
  "version": "1.0.0",
  "productName": "便签",
  "description": "Windows 桌面便签 - Electron 毛玻璃风格",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsup",
    "build:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "build:ts": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "start": "npm run build:ts && electron .",
    "test": "node --test",
    "pack": "npm run build:ts && node scripts/build-win.js"
  },
  "keywords": [
    "sticky-note",
    "electron",
    "notes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@types/adm-zip": "^0.5.8",
    "@types/dompurify": "^3.0.5",
    "@types/howler": "^2.2.13",
    "@types/marked": "^5.0.2",
    "@types/node": "^26.1.2",
    "electron": "^42.7.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "adm-zip": "^0.6.0",
    "dompurify": "^3.2.0",
    "howler": "^2.2.4",
    "marked": "^12.0.2",
    "music-metadata": "^7.14.0"
  }
}
